---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = site.tagline, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
---

<!doctype html>
<html lang="en" data-theme="sage">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Apply saved / system theme before first paint (no flash). Respects prefers-contrast and prefers-color-scheme. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t;
        try { t = localStorage.getItem('ga-theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-contrast: more)').matches ? 'contrast' : matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'sage';
        d.dataset.theme = t;
        d.classList.add('js');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,300..700;1,300..600&family=Montserrat:wght@400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <ga-progress aria-hidden="true"></ga-progress>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/components.ts';
    </script>
  </body>
</html>
