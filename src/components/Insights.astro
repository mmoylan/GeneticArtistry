---
import { getEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { getPosts } from '../lib/insights';
/** Page-builder block: insights (latest posts, optionally from one category). Renders nothing when there are none. */
interface Props { data?: Record<string, any>; uid?: string; anchor?: string }
const { data = {}, uid = 'insights', anchor = '' } = Astro.props;
const { eyebrow = 'Insights', heading = 'Notes from the grow room', count = 3, category = '', button_label = 'All insights' } = data;
const posts = (await getPosts(category || undefined)).slice(0, Math.max(1, count));
const cat = category ? await getEntry('categories', category) : undefined;
const href = cat ? `/insights/category/${cat.id}` : '/insights';
---

{posts.length > 0 && (
  <section id={anchor || undefined} class="pad insights" aria-labelledby={`${uid}-title`}>
    <div class="wrap">
      <div class="head">
        <div>
          {eyebrow && <ga-reveal><p class="eyebrow">{eyebrow}</p></ga-reveal>}
          {heading && <h2 id={`${uid}-title`}><ga-split>{heading}</ga-split></h2>}
        </div>
        {button_label && <a class="btn" href={href}>{button_label}</a>}
      </div>
      <ul class="grid">{posts.map((p) => <PostCard post={p} />)}</ul>
    </div>
  </section>
)}

<style>
  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .head h2 { margin: 1rem 0 0; max-width: 16ch; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
</style>
