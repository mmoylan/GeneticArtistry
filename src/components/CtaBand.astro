---
/** Page-builder block: cta (accent banner with a heading, a line of text and one button). */
interface Props { data?: Record<string, any>; uid?: string; anchor?: string }
const { data = {}, uid = 'cta', anchor = '' } = Astro.props;
const { heading = '', text = '', button_label = '', button_link = '#connect' } = data;
---

{(heading || text) && (
  <section id={anchor || undefined} class="pad" aria-labelledby={heading ? `${uid}-title` : undefined}>
    <div class="wrap">
      <div class="band">
        {heading && <h2 id={`${uid}-title`}><ga-split>{heading}</ga-split></h2>}
        {text && <ga-reveal><p class="lede">{text}</p></ga-reveal>}
        {button_label && <ga-reveal><a class="go" href={button_link}>{button_label}</a></ga-reveal>}
      </div>
    </div>
  </section>
)}

<style>
  .band { background: var(--accent); color: var(--on-accent); border-radius: 28px; padding: clamp(2rem, 6vw, 5rem); text-align: center; }
  h2 { margin: 0 auto 1rem; max-width: 20ch; color: var(--on-accent); }
  .lede { margin: 0 auto 2rem; color: var(--on-accent); }
  .go { display: inline-flex; align-items: center; min-height: 48px; padding: .85rem 1.7rem; border-radius: 999px; background: var(--on-accent); color: var(--accent); text-decoration: none; font: 700 .8rem/1 var(--sans); letter-spacing: .08em; transition: transform .3s var(--ease); }
  .go:hover { transform: translateY(-2px); }
</style>
