---
import site from '../data/site.json';
import Logo from './Logo.astro';
---

<section class="hero">
  <div class="wrap inner">
    <Logo variant="text-below" height={220} />
    <h1>{site.tagline}</h1>
    <div class="cta">
      <a class="btn primary" href="#connect">Get in touch</a>
      <a class="btn" href="/blog">Read the blog</a>
    </div>
  </div>
</section>

<style>
  .hero { padding: 4rem 0 3rem; text-align: center; }
  .inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  h1 { max-width: 18ch; margin: 0; }
  .cta { display: flex; gap: .8rem; flex-wrap: wrap; justify-content: center; }
</style>
