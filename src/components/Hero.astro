---
import story from '../data/story.json';
import LeafArt from './LeafArt.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="panel bleed">
    <div class="art" aria-hidden="true">
      <div class="glow a"></div>
      <div class="glow b"></div>
      <div class="grid"></div>
      <ga-parallax speed="-0.1">
        <ga-draw autoplay>
          <LeafArt class="leaf" stroke={1.1} />
        </ga-draw>
      </ga-parallax>
      <!-- dimension annotations, like a technical drawing -->
      <svg class="dims" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width=".7">
        <path d="M70 40H330M70 34V46M330 34V46" />
        <path d="M356 40V270M350 40H362M350 270H362" />
        <text x="200" y="30" text-anchor="middle" fill="currentColor" stroke="none">Ø 24 cm</text>
        <text x="372" y="160" fill="currentColor" stroke="none" transform="rotate(90 372 160)" text-anchor="middle">30 cm</text>
      </svg>
      <p class="fig label">Fig. 01 — Palmate leaf, 7 leaflets</p>
    </div>

    <div class="content">
      <ga-reveal effect="fade"><p class="eyebrow">{story.hero_eyebrow}</p></ga-reveal>
      <h1 id="hero-title"><ga-split set:html={story.hero_title} /></h1>
      <ga-reveal delay="500"><p class="lede">{story.hero_lede}</p></ga-reveal>
      <ga-reveal delay="700" class="cta">
        <a class="b solid" href="#collection">Explore the collection</a>
        <a class="b" href="#connect">Get in touch</a>
      </ga-reveal>
    </div>
  </div>
</section>

<style>
  .hero { padding: 12px; }
  /* The panel is always dark so white text keeps its contrast in every theme. */
  .panel { min-height: calc(100svh - 24px); border-radius: 28px; background: linear-gradient(160deg, #0d2418 0%, #14342a 55%, #1a3a2c 100%); color: #fff; display: flex; align-items: flex-end; }
  .content { position: relative; padding: clamp(6rem, 12vw, 8rem) clamp(1.4rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4rem); max-width: 60rem; }
  h1 { font-size: var(--t-mega); margin: 1.2rem 0 1.4rem; color: #fff; max-width: 11ch; }
  h1 :global(em) { color: #bfe3c3; }
  .eyebrow { color: #bfe3c3; }
  .lede { color: #e6efe7; margin-bottom: 2rem; }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; }
  .b { display: inline-flex; align-items: center; min-height: 48px; padding: .85rem 1.7rem; border-radius: 999px; border: 1.5px solid #fff; color: #fff; text-decoration: none; font: 700 .8rem/1 var(--sans); letter-spacing: .08em; transition: transform .3s var(--ease), background .3s; }
  .b:hover { transform: translateY(-2px); background: rgba(255,255,255,.14); }
  .b.solid { background: #fff; color: #0d2418; }
  .b.solid:hover { background: #e9f3ea; }
  .art :global(.leaf) { position: absolute; right: 4vw; top: 8vh; width: min(52vw, 760px); color: #8fcf9a; opacity: .9; }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 75%); }
  .dims { position: absolute; right: 2vw; top: 6vh; width: min(58vw, 840px); color: #cfe9d3; opacity: .7; font: 600 9px var(--sans); letter-spacing: .1em; }
  .fig { position: absolute; right: clamp(1.4rem, 5vw, 4.5rem); bottom: 2rem; margin: 0; color: #cfe9d3; }
  .glow { position: absolute; border-radius: 50%; filter: blur(100px); animation: drift 24s ease-in-out infinite alternate; }
  .glow.a { width: 55vw; height: 55vw; right: -10vw; top: -20vw; background: #2f7a4a; opacity: .45; }
  .glow.b { width: 40vw; height: 40vw; left: -12vw; bottom: -14vw; background: #6d5b1f; opacity: .35; animation-delay: -10s; }
  @keyframes drift { to { transform: translate3d(-6vw, 5vh, 0) scale(1.12); } }
  @media (max-width: 760px) { .fig, .dims { display: none; } .art :global(.leaf) { width: 95vw; right: -20vw; opacity: .5; } }
  @media (prefers-reduced-motion: reduce) { .glow { animation: none; } }
</style>
