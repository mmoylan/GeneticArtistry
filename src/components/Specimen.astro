---
import story from '../data/story.json';
import site from '../data/site.json';
import { marked } from 'marked';
import LeafArt from './LeafArt.astro';
const about = marked.parse(site.about) as string;
// Botanical facts about the palmate cannabis leaf (accurate, not placeholder).
const anatomy = [
  ['Arrangement', 'Palmate compound'],
  ['Leaflets', '5 to 9, always odd'],
  ['Margin', 'Serrate (toothed)'],
  ['Phyllotaxy', 'Opposite, then alternate'],
];
---

<section id="specimen" class="pad" aria-labelledby="specimen-title">
  <div class="wrap">
    <div class="intro">
      <ga-reveal><p class="eyebrow">About</p></ga-reveal>
      <h2 id="specimen-title"><ga-split>{site.about_heading}</ga-split></h2>
      <ga-reveal><div class="muted prose" set:html={about} /></ga-reveal>
    </div>

    <div class="bento">
      <ga-reveal class="plate card">
        <p class="label muted">Plate I — The leaf</p>
        <p class="display caption">Each line is judged leaf by leaf: structure first, then aroma, then vigour.</p>
        <ga-draw aria-hidden="true" class="bgleaf"><LeafArt class="art-leaf" stroke={1.2} /></ga-draw>
      </ga-reveal>

      <ga-reveal class="card anatomy" delay="100">
        <p class="label muted">Anatomy</p>
        <dl>
          {anatomy.map(([k, v]) => (<div><dt class="label">{k}</dt><dd>{v}</dd></div>))}
        </dl>
      </ga-reveal>

      <ga-reveal class="card manifesto" delay="150">
        <p class="label muted">Philosophy</p>
        <p class="display quote">{story.manifesto}</p>
      </ga-reveal>
    </div>
  </div>
</section>

<style>
  .intro { max-width: 48rem; margin-bottom: 3rem; }
  .intro h2 { margin: 1rem 0 1.2rem; }
  .bento { display: grid; gap: 1.1rem; grid-template-columns: repeat(12, 1fr); }
  /* The leaf is a large, faint, partly cropped background; the text sits clear of it. */
  .plate { grid-column: span 7; grid-row: span 2; position: relative; overflow: hidden; min-height: 26rem; display: flex; flex-direction: column; gap: 1rem; }
  .plate > :not(.bgleaf) { position: relative; z-index: 1; }
  .plate .caption { max-width: 22ch; }
  .plate .bgleaf { position: absolute; right: -16%; bottom: -34%; width: 82%; color: var(--leaf); opacity: .28; pointer-events: none; }
  .plate :global(.art-leaf) { width: 100%; height: auto; }
  .anatomy { grid-column: span 5; }
  .manifesto { grid-column: span 5; background: var(--accent); color: var(--on-accent); }
  .manifesto .label { color: var(--on-accent); opacity: 1; }
  .quote { font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.45; font-weight: 400; margin: .8rem 0 0; }
  .caption { margin: 0; font-size: clamp(1.4rem, 2.6vw, 2.1rem); line-height: 1.2; font-weight: 400; }
  dl { margin: 1rem 0 0; display: grid; gap: 1rem; }
  dl div { border-top: 1px solid var(--line); padding-top: .8rem; display: flex; justify-content: space-between; gap: 1rem; }
  dt { color: var(--leaf); } dd { margin: 0; text-align: right; font-family: var(--display); }
  @media (max-width: 980px) { .plate, .anatomy, .manifesto { grid-column: span 12; } .plate { min-height: 20rem; } }
</style>
