---
import site from '../data/site.json';
const { email, phone, location } = site.contact;
---

<div class="card">
  <h3>Get in touch</h3>
  <ul>
    {email && <li><strong>Email</strong> <a href={`mailto:${email}`}>{email}</a></li>}
    {phone && <li><strong>Phone</strong> <a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a></li>}
    {location && <li><strong>Location</strong> {location}</li>}
  </ul>
</div>

<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  strong { display: inline-block; min-width: 5.5rem; color: var(--muted); font-weight: 600; }
</style>
