---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; index?: number }
const { post, index = 0 } = Astro.props;
const { title, date, description, tags } = post.data;
---

<li class="row">
  <a href={`/blog/${post.id}`}>
    <span class="idx num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <span class="main">
      <time class="label muted" datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}{tags.length > 0 && ` · ${tags.join(', ')}`}</time>
      <span class="title display">{title}</span>
      {description && <span class="desc muted">{description}</span>}
    </span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .row { border-top: 1px solid var(--line); }
  a { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem 2rem; align-items: center; padding: 2.2rem 0; text-decoration: none; transition: padding .5s var(--ease), color .3s; }
  a:hover { color: var(--accent); padding-inline: 1.2rem; }
  .idx { font-size: clamp(2.4rem, 5vw, 4rem); color: var(--muted); }
  .main { display: grid; gap: .5rem; }
  .title { font-size: clamp(1.8rem, 4.4vw, 3.8rem); line-height: 1.02; letter-spacing: -.03em; font-weight: 300; }
  .desc { max-width: 60ch; font-size: 1rem; }
  .arrow { font-size: 2.2rem; transition: transform .5s var(--ease); }
  a:hover .arrow { transform: translateX(.6rem); }
</style>
