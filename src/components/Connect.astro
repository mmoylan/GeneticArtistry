---
import site from '../data/site.json';
import story from '../data/story.json';
import SocialLinks from './SocialLinks.astro';
import InstagramFeed from './InstagramFeed.astro';
const { email, phone, location } = site.contact;
---

<section id="connect" class="pad" aria-labelledby="connect-title">
  <div class="wrap">
    <div class="panel">
      <ga-reveal><p class="eyebrow">Contact</p></ga-reveal>
      <h2 id="connect-title" class="mega"><ga-split set:html={story.connect_heading} /></h2>
      {email && <ga-reveal><a class="mail display" href={`mailto:${email}`}>{email}</a></ga-reveal>}
      <div class="cols">
        <ga-reveal>
          <h3 class="label">Reach out</h3>
          <ul class="plain">
            {phone && <li><a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a></li>}
            {location && <li>{location}</li>}
          </ul>
        </ga-reveal>
        <ga-reveal delay="120">
          <h3 class="label">Follow</h3>
          <SocialLinks />
        </ga-reveal>
      </div>
      <ga-reveal class="ig"><InstagramFeed /></ga-reveal>
    </div>
  </div>
</section>

<style>
  .panel { background: var(--accent); color: var(--on-accent); border-radius: 28px; padding: clamp(2rem, 6vw, 5rem); }
  .panel :global(.eyebrow), .panel :global(em) { color: var(--on-accent); }
  .panel :global(em) { font-style: italic; opacity: 1; }
  h2 { margin: 1.2rem 0 2rem; max-width: 14ch; }
  .mail { display: inline-block; font-size: clamp(1.4rem, 4vw, 3rem); margin-bottom: 3rem; word-break: break-word; text-decoration-thickness: 2px; text-underline-offset: .18em; }
  .mail:hover { text-decoration-thickness: 4px; }
  .cols { display: grid; gap: 2rem 4rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1px solid color-mix(in srgb, var(--on-accent) 35%, transparent); padding-top: 2rem; }
  h3.label { font-family: var(--sans); font-size: var(--t-label); letter-spacing: .24em; text-transform: uppercase; margin: 0 0 1rem; line-height: 1.4; }
  .plain { list-style: none; margin: 0; padding: 0; font-family: var(--display); font-size: 1.3rem; }
  .plain li { min-height: 44px; display: flex; align-items: center; }
  .panel :global(.links a) { font-size: 1.3rem; text-decoration-color: currentColor; }
  .panel :global(.links a:hover) { color: var(--on-accent); text-decoration-thickness: 3px; }
  .ig { margin-top: 3rem; }
</style>
