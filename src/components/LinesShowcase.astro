---
import lines from '../data/lines.json';
import story from '../data/story.json';
import LeafArt from './LeafArt.astro';
const list = lines.lines;
---

<section id="collection" class="bleed lines" aria-labelledby="lines-title">
  <ga-hscroll>
    <div class="sticky">
      <div class="track">
        <div class="intro">
          <p class="eyebrow">{String(list.length).padStart(2, '0')} lines</p>
          <h2 id="lines-title">{story.lines_heading}</h2>
          <p class="lede">{story.lines_intro}</p>
          <p class="hint label muted"><span aria-hidden="true">Scroll →</span></p>
        </div>

        {list.map((l, i) => (
          <article class="card" aria-labelledby={`line-${i}`}>
            <div class="plate" style={`--c1:${l.c1};--c2:${l.c2}`} aria-hidden="true">
              <LeafArt class="lf" stroke={1.2} />
              <span class="n display">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="body">
              <p class="label meta"><span>{l.type}</span><span class="status">{l.status}</span></p>
              <h3 id={`line-${i}`}>{l.name}</h3>
              <p class="lineage">{l.lineage}</p>
              <p class="muted notes">{l.notes}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </ga-hscroll>
</section>

<style>
  .lines { background: var(--bg-2); border-block: 1px solid var(--line); }
  .sticky { padding-block: 5rem; }
  .intro { flex: 0 0 min(88vw, 520px); display: flex; flex-direction: column; justify-content: center; padding-right: 3vw; }
  .intro h2 { margin: 1rem 0 1.5rem; }
  .hint { margin-top: 2rem; }
  .card { flex: 0 0 min(84vw, 440px); display: flex; flex-direction: column; background: var(--bg); border: 1px solid var(--line); }
  .plate { position: relative; aspect-ratio: 4 / 4.2; background: linear-gradient(150deg, var(--c1), var(--c2)); overflow: hidden; color: #fff; }
  .plate .lf { position: absolute; left: 50%; bottom: -14%; width: 120%; transform: translateX(-50%); opacity: .5; transition: transform 1.2s var(--ease), opacity .6s; }
  .card:hover .lf { transform: translateX(-50%) scale(1.06) rotate(3deg); opacity: .8; }
  .n { position: absolute; left: 1.4rem; top: .6rem; font-size: 5.5rem; font-weight: 200; line-height: 1; letter-spacing: -.06em; opacity: .9; }
  .body { padding: 1.6rem 1.6rem 2rem; }
  .meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--accent); margin: 0 0 1rem; }
  .status { color: var(--muted); }
  h3 { font-size: clamp(2rem, 3.4vw, 2.8rem); margin: 0 0 .3em; }
  .lineage { font-family: var(--display); font-style: italic; font-weight: 300; font-size: 1.2rem; margin: 0 0 .8rem; }
  .notes { margin: 0; font-size: 1rem; }
</style>
