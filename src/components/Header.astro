---
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<header class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="Genetic Artistry, home">
      <Logo variant="mark" height={44} decorative />
      <span class="name">Genetic Artistry</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        <li><a href="/#collection">Collection</a></li>
        <li><a href="/#process">Process</a></li>
        <li><a href="/blog">Journal</a></li>
        <li><a href="/#connect">Contact</a></li>
      </ul>
    </nav>
    <details class="theme">
      <summary>Theme</summary>
      <div class="panel"><ThemeSwitcher /></div>
    </details>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 80; background: color-mix(in srgb, var(--bg) 84%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 1.5rem; padding: .55rem clamp(1rem, 3vw, 2rem); }
  .brand { display: flex; align-items: center; gap: .8rem; text-decoration: none; margin-right: auto; min-height: 44px; }
  .name { font-family: var(--display); font-size: 1.35rem; font-weight: 400; letter-spacing: -.01em; }
  nav ul { display: flex; gap: .4rem; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 .8rem; text-decoration: none; font: 700 var(--t-label)/1 var(--sans); letter-spacing: .2em; text-transform: uppercase; }
  nav a:hover { color: var(--accent); }
  .theme { position: relative; }
  summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border: 1px solid var(--line); font: 700 var(--t-label)/1 var(--sans); letter-spacing: .2em; text-transform: uppercase; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, details[open] summary { border-color: var(--accent); color: var(--accent); }
  .panel { position: absolute; right: 0; top: calc(100% + .5rem); width: min(86vw, 340px); padding: 1rem; background: var(--bg-2); border: 1px solid var(--line); }
  @media (max-width: 860px) { nav { display: none; } .name { display: none; } }
</style>
