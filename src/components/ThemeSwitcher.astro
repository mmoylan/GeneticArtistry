---
const themes = [
  { id: 'paper', label: 'Paper', bg: '#ffffff', fg: '#1c2b5a' },
  { id: 'sage', label: 'Sage', bg: '#dfe7d8', fg: '#23472f' },
  { id: 'night', label: 'Night', bg: '#0e1412', fg: '#a9c4ff' },
  { id: 'contrast', label: 'High contrast', bg: '#ffffff', fg: '#0000b3' },
];
---

<ga-theme>
  <ul class="themes" aria-label="Colour scheme">
    {themes.map((t) => (
      <li>
        <button type="button" data-theme-value={t.id} aria-pressed="false">
          <span class="sw" style={`background:linear-gradient(135deg,${t.bg} 50%,${t.fg} 50%)`} aria-hidden="true"></span>
          {t.label}
        </button>
      </li>
    ))}
  </ul>
</ga-theme>
