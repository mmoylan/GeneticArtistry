---
import story from '../data/story.json';
---

<section id="process" class="bleed pad" aria-labelledby="process-title">
  <div class="wrap layout">
    <div class="head">
      <ga-reveal><p class="eyebrow">Method</p></ga-reveal>
      <h2 id="process-title"><ga-split>{story.process_heading}</ga-split></h2>
    </div>
    <ol class="steps">
      {story.process.map((s, i) => (
        <li>
          <ga-reveal>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </ga-reveal>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .layout { display: grid; gap: 3rem 6rem; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .layout { grid-template-columns: .9fr 1.1fr; align-items: start; } .head { position: sticky; top: 7rem; } }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; }
  li { border-top: 1px solid var(--line); padding: 2.5rem 0 4rem; }
  li:last-child { padding-bottom: 0; }
  ga-reveal { display: grid; grid-template-columns: auto 1fr; column-gap: 2rem; align-items: start; }
  .num { grid-row: span 2; }
  h3 { margin: 0 0 .4em; }
  p { margin: 0; max-width: 46ch; }
</style>
