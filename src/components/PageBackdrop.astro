---
import LeafArt from './LeafArt.astro';
/**
 * Page-wide background: one huge outline leaf (200% of the page width, 40% of it off the chosen screen edge) fixed behind everything,
 * drifting and turning slowly as the page scrolls (<ga-parallax scope="page">).
 * Very low contrast on purpose; it never changes the readability of text (see strength below).
 * Level comes from each page's "Background leaf" setting in the CMS.
 */
interface Props { level?: 'none' | 'subtle' | 'medium'; position?: 'left' | 'right' | 'center' }
const { level = 'subtle', position = 'left' } = Astro.props;
const opacity = { subtle: 0.6, medium: 0.85 }[level as 'subtle'] ?? 0;
---

{level !== 'none' && (
  <div class="backdrop" data-pos={position} aria-hidden="true" style={`--bd-op:${opacity}`}>
    <ga-parallax scope="page" speed="0.1" rotate="0.0025">
      <LeafArt class="bd-leaf" stroke={1.6} />
    </ga-parallax>
  </div>
)}

<style>
  .backdrop { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  /* The leaf is 200vw wide. 'left' / 'right' put 40% of its width off that screen edge (the visible 60% fans into the page);
     'center' centres it. The hub where the leaflets meet (50% across, ~76% down the drawing) starts 110% of the way
     down the screen (just below the bottom edge), so only the fan rises into view from the bottom. Turning pivots on that hub. */
  .backdrop :global(ga-parallax) { position: absolute; width: 200vw; left: -80vw; top: calc(110vh - 139.1vw); transform-origin: 50% 76.2%; }
  .backdrop[data-pos='right'] :global(ga-parallax) { left: -20vw; }
  .backdrop[data-pos='center'] :global(ga-parallax) { left: -50vw; }
  .backdrop :global(.bd-leaf) { width: 100%; height: auto; color: var(--tan, #d6c28a); opacity: var(--bd-op, .6); }
  /* Hairline strokes at any size, so the huge leaf stays delicate instead of getting thick. */
  .backdrop :global(.bd-leaf *) { vector-effect: non-scaling-stroke; }
  @media (prefers-contrast: more) { .backdrop { display: none; } }
  @media print { .backdrop { display: none; } }
</style>
