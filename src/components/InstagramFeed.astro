---
import site from '../data/site.json';
const { handle, behold_feed_id } = site.instagram;
const profile = handle ? `https://instagram.com/${handle}` : '';
---

{behold_feed_id ? (
  <section aria-label="Latest from Instagram" class="feed">
    <behold-widget feed-id={behold_feed_id}></behold-widget>
    <script type="module" src="https://w.behold.so/widget.js" is:inline></script>
  </section>
) : profile ? (
  <p>Follow along on <a href={profile} target="_blank" rel="noopener noreferrer">@{handle}<span class="sr-only"> (opens in a new tab)</span></a>.</p>
) : null}
