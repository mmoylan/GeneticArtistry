---
import { getCategories, getPosts } from '../lib/insights';
/** Filter chips for the Insights pages: "All" plus every category that has at least one published post. */
interface Props { current?: string }
const { current } = Astro.props;
const posts = await getPosts();
const categories = (await getCategories()).filter((c) => posts.some((p) => p.data.category === c.id));
---

{categories.length > 0 && (
  <nav class="chips" aria-label="Insight categories">
    <ul>
      <li><a href="/insights" aria-current={!current ? 'page' : undefined}>All</a></li>
      {categories.map((c) => (
        <li><a href={`/insights/category/${c.id}`} aria-current={current === c.id ? 'page' : undefined}>{c.data.title}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  .chips ul { list-style: none; margin: 0 0 2.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.2rem; border: 1.5px solid var(--accent); border-radius: 999px; color: var(--accent); text-decoration: none; font: 700 .75rem/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; transition: background .25s var(--ease), color .25s var(--ease); }
  a:hover, a[aria-current='page'] { background: var(--accent); color: var(--on-accent); }
</style>
