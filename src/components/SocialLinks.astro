---
import site from '../data/site.json';
---

<ul class="links">
  {site.socials.filter((s) => s.url).map((s) => (
    <li><a href={s.url} target="_blank" rel="noopener noreferrer me">{s.label}<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span></a></li>
  ))}
</ul>

<style>
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem 1.4rem; }
  a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; font-family: var(--display); font-size: 1.6rem; font-weight: 300; text-decoration-color: var(--line); }
  a:hover { color: var(--accent); text-decoration-color: var(--accent); }
</style>
