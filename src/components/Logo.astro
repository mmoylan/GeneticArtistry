---
/**
 * Inline, theme-aware Leaf A logo: two leaflets of the site's leaf form the legs of an A, a tan crossbar finishes it.
 * Colours come from the site palette (--accent, --leaf, --ink). Company title only, no subtitle.
 * Standalone files (colour, ivory, single-colour, icon) live in /public/logo; the generator is brand/logo-concepts/build-leaf-a.mjs.
 *
 * Variants: mark | text-below | text-above | horizontal
 */
interface Props {
  variant?: 'mark' | 'text-below' | 'text-above' | 'horizontal';
  height?: number;
  decorative?: boolean; // true when adjacent text already names the brand
}
const { variant = 'mark', height = 48, decorative = false } = Astro.props;

// The mark is drawn with its apex at (0,0): x -122..122, y -26..292.
const PETAL = 'M0 0C-40 -93 -40 -217 0 -310C40 -217 40 -93 0 0Z';
const M = { x: -122, y: -26, w: 244, h: 318 };
const f = (n: number) => +n.toFixed(2);
const word = (size: number) => Math.round(size * 14.4); // fixed text length: same spacing in any font

let W = 0, H = 0, tx = 0, ty = 0, s = 1;
let text: { x: number; y: number; size: number; len: number; anchor: string } | null = null;

if (variant === 'mark') {
  const pad = 12;
  W = M.w + pad * 2; H = M.h + pad * 2; tx = M.w / 2 + pad; ty = -M.y + pad;
} else if (variant === 'text-below' || variant === 'text-above') {
  s = 1.1;
  const F = 36, pad = 28, gap = 32, cap = F * 0.72, len = word(F), mh = M.h * s;
  W = len + pad * 2;
  if (variant === 'text-below') {
    const baseline = pad + mh + gap + cap;
    H = baseline + pad; tx = W / 2; ty = pad - M.y * s;
    text = { x: W / 2, y: baseline, size: F, len, anchor: 'middle' };
  } else {
    const baseline = pad + cap, top = baseline + gap;
    H = top + mh + pad; tx = W / 2; ty = top - M.y * s;
    text = { x: W / 2, y: baseline, size: F, len, anchor: 'middle' };
  }
} else {
  s = 0.78;
  const F = 40, pad = 28, gap = 44, len = word(F), mw = M.w * s, mh = M.h * s;
  H = mh + pad * 2; W = pad + mw + gap + len + pad; tx = pad + mw / 2; ty = pad - M.y * s;
  text = { x: pad + mw + gap, y: H / 2 + F * 0.36, size: F, len, anchor: 'start' };
}
---

<svg
  class="logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${f(W)} ${f(H)}`}
  style={`height:${height}px;width:auto`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Genetic Artistry'}
  aria-hidden={decorative ? 'true' : undefined}
>
  <defs>
    <!-- the clips leave a 2-unit slit where the two legs overlap at the apex -->
    <clipPath id="la-l"><rect x="-300" y="-60" width="299" height="420" /></clipPath>
    <clipPath id="la-r"><rect x="1" y="-60" width="299" height="420" /></clipPath>
  </defs>
  <g transform={`translate(${f(tx)} ${f(ty)}) scale(${s})`}>
    <g clip-path="url(#la-l)"><path class="leg" transform="rotate(202)" d={PETAL} /></g>
    <g clip-path="url(#la-r)"><path class="leg" transform="rotate(158)" d={PETAL} /></g>
    <rect class="bar" x="-56" y="166" width="112" height="14" rx="7" />
    <circle class="dot" cx="0" cy="-16" r="9" />
  </g>
  {text && (
    <text class="word" x={f(text.x)} y={f(text.y)} text-anchor={text.anchor} font-size={text.size} textLength={text.len} lengthAdjust="spacing">GENETIC ARTISTRY</text>
  )}
</svg>

<style>
  .logo { overflow: visible; }
  .leg { fill: var(--accent); }
  .bar { fill: #c9b27a; }
  .dot { fill: var(--leaf); }
  .word { fill: var(--ink); font-family: var(--display); font-weight: 500; }
</style>
