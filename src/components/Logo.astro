---
/**
 * Inline, theme-aware logo. Colours come from the active palette (--ink, --leaf, --accent),
 * so it stays readable in every theme. Standalone files for print live in /public/logo.
 */
interface Props {
  variant?: 'mark' | 'text-below' | 'text-above';
  height?: number;
  decorative?: boolean; // true when adjacent text already names the brand
}
const { variant = 'mark', height = 48, decorative = false } = Astro.props;
const withText = variant !== 'mark';
const vbH = withText ? 470 : 400;
const markY = variant === 'text-above' ? 70 : 0;
const textY = variant === 'text-above' ? 42 : 446;
const id = 'leaf-' + Math.random().toString(36).slice(2, 8);
---

<svg
  class="logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 400 ${vbH}`}
  style={`height:${height}px;width:auto`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Genetic Artistry'}
  aria-hidden={decorative ? 'true' : undefined}
>
  <defs>
    <g id={id} class="leaf">
      <path d="M0 0C-7-14-7-32 0-46C7-32 7-14 0 0Z" />
      <path transform="rotate(-28)" d="M0 0C-6.5-12-6.5-28 0-40C6.5-28 6.5-12 0 0Z" />
      <path transform="rotate(28)" d="M0 0C-6.5-12-6.5-28 0-40C6.5-28 6.5-12 0 0Z" />
      <path transform="rotate(-56)" d="M0 0C-5.5-10-5.5-22 0-32C5.5-22 5.5-10 0 0Z" />
      <path transform="rotate(56)" d="M0 0C-5.5-10-5.5-22 0-32C5.5-22 5.5-10 0 0Z" />
      <path transform="rotate(-82)" d="M0 0C-4.5-7-4.5-15 0-22C4.5-15 4.5-7 0 0Z" />
      <path transform="rotate(82)" d="M0 0C-4.5-7-4.5-15 0-22C4.5-15 4.5-7 0 0Z" />
      <path class="stem" d="M0 0V16" />
    </g>
  </defs>
  <g transform={`translate(0 ${markY})`}>
    <path class="ink" d="M230.4 132.5A105 105 0 1 0 255 204H178" stroke-width="24" />
    <path class="ink" d="M265 62L188 338" stroke-width="26" />
    <path class="ink" d="M222 204H302" stroke-width="22" />
    <path class="ink" d="M265 62L312 214" stroke-width="26" />
    <path class="ink-fill" d="M258 52Q265 44 272 52L272 66L258 66Z" />
    <path class="ferrule" d="M295.8 219L328.2 209L335.9 233.8L303.5 243.8Z" />
    <path class="bristle" d="M303.5 243.8L335.9 233.8C339 256 335 270 330 280C320 272 301 260 303.5 243.8Z" />
    <path class="trail" d="M331 282C372 300 384 352 304 368C262 376 220 372 178 360" />
    <use href={`#${id}`} transform="translate(352 304) rotate(55) scale(.95)" />
    <use href={`#${id}`} transform="translate(366 336) rotate(115) scale(.85)" />
    <use href={`#${id}`} transform="translate(336 363) rotate(172) scale(.8)" />
    <use href={`#${id}`} transform="translate(282 373) rotate(184) scale(.68)" />
    <use href={`#${id}`} transform="translate(232 372) rotate(190) scale(.55)" />
  </g>
  {withText && (
    <text x="200" y={textY} text-anchor="middle" class="word" font-size="28" letter-spacing="5">GENETIC ARTISTRY</text>
  )}
</svg>

<style>
  .logo { overflow: visible; }
  .ink { fill: none; stroke: var(--ink); }
  .ink-fill { fill: var(--ink); }
  .ferrule { fill: var(--accent); }
  .bristle, .leaf { fill: var(--leaf); }
  .stem { stroke: var(--leaf); stroke-width: 3; stroke-linecap: round; fill: none; }
  .trail { fill: none; stroke: var(--leaf); stroke-width: 7; stroke-linecap: round; }
  .word { fill: var(--ink); font-family: var(--display); font-weight: 400; }
</style>
