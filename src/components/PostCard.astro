---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, date, description, cover } = post.data;
---

<article class="post">
  <a href={`/blog/${post.id}`}>
    {cover && <img src={cover} alt="" loading="lazy" />}
    <div class="body">
      <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time>
      <h3>{title}</h3>
      {description && <p>{description}</p>}
    </div>
  </a>
</article>

<style>
  .post { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .15s, border-color .15s; }
  .post:hover { transform: translateY(-3px); border-color: var(--green); }
  a { color: inherit; text-decoration: none; display: block; height: 100%; }
  img { aspect-ratio: 16/9; object-fit: cover; width: 100%; }
  .body { padding: 1.2rem 1.4rem 1.5rem; }
  time { color: var(--muted); font-size: .85rem; }
  h3 { margin: .2rem 0 .4rem; font-size: 1.6rem; }
  p { margin: 0; color: var(--muted); }
</style>
