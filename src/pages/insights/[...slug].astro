---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getPosts, getCategoryOf, getAuthorOf } from '../../lib/insights';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, description, cover, tags } = post.data;
const category = await getCategoryOf(post);
const author = await getAuthorOf(post);
---

<Base title={title} description={description}>
  <article class="wrap pad top">
    <a class="back label" href="/insights">← All insights</a>
    {category && <p class="cat"><a class="label" href={`/insights/category/${category.id}`}>{category.data.title}</a></p>}
    <h1>{title}</h1>
    <p class="meta label muted">
      <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time>
      {tags.length > 0 && <span> · {tags.join(', ')}</span>}
    </p>
    {cover && <img src={cover} alt="" class="cover" />}
    <div class="layout">
      <div class="prose"><Content /></div>
      {author && (
        <aside class="rail" aria-label="About the author">
          <AuthorCard person={author} />
        </aside>
      )}
    </div>
  </article>
</Base>

<style>
  .top { padding-top: clamp(8rem, 16vw, 12rem); }
  .back { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--accent); }
  .cat { margin: 1.2rem 0 0; }
  .cat a { display: inline-flex; align-items: center; min-height: 44px; color: var(--leaf); }
  h1 { margin: .4rem 0 1rem; font-size: var(--t-1); max-width: 16ch; }
  .cover { margin: 2.5rem 0; width: 100%; }
  /* Article text with a side rail: the author card stays in view beside the text on wide screens, and follows it on small ones. */
  .layout { display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr); margin-top: 2rem; }
  @media (min-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr) 320px; gap: 4rem; } .rail { position: sticky; top: 7rem; align-self: start; } }
</style>
