---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getPosts } from '../../lib/insights';

const posts = await getPosts();
---

<Base title="Insights" description="Business insights, cultivation notes and grow journals from Genetic Artistry.">
  <section class="backing top pad">
    <div class="wrap">
      <p class="eyebrow">Insights</p>
      <h1>Notes from the <em>grow room</em></h1>
      <CategoryNav />
      {posts.length === 0 ? <p class="muted">No insights yet.</p> : (
        <ul class="grid">{posts.map((p) => <PostCard post={p} />)}</ul>
      )}
    </div>
  </section>
</Base>

<style>
  h1 { margin: 1.2rem 0 2rem; max-width: 14ch; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
</style>
