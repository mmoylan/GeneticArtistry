---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Manifesto from '../components/Manifesto.astro';
import LinesShowcase from '../components/LinesShowcase.astro';
import Process from '../components/Process.astro';
import Stats from '../components/Stats.astro';
import PostRow from '../components/PostRow.astro';
import Connect from '../components/Connect.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <Hero />
  <Marquee />
  <Manifesto />
  <LinesShowcase />
  <Process />
  <Stats />
  {posts.length > 0 && (
    <section class="pad" aria-labelledby="journal-title">
      <div class="wrap">
        <div class="head">
          <div>
            <ga-reveal><p class="eyebrow">Journal</p></ga-reveal>
            <h2 id="journal-title"><ga-split>Notes from the grow room</ga-split></h2>
          </div>
          <a class="btn" href="/blog">All entries</a>
        </div>
        <ol class="list">{posts.map((p, i) => <PostRow post={p} index={i} />)}</ol>
      </div>
    </section>
  )}
  <Connect />
</Base>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
  .head h2 { margin: 1rem 0 0; max-width: 14ch; }
  .list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
</style>
