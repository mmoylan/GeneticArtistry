---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ContactCard from '../components/ContactCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import PostCard from '../components/PostCard.astro';
import site from '../data/site.json';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const aboutHtml = marked.parse(site.about) as string;
---

<Base>
  <Hero />

  <Section id="about" title={site.about_heading}>
    <div class="prose" set:html={aboutHtml} />
  </Section>

  {posts.length > 0 && (
    <Section title="Latest from the blog">
      <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
      <p class="more"><a href="/blog">All posts →</a></p>
    </Section>
  )}

  <Section id="connect" title="Connect">
    <div class="connect">
      <ContactCard />
      <div class="social">
        <h3>Find us online</h3>
        <SocialLinks />
      </div>
    </div>
    <div class="ig"><InstagramFeed /></div>
  </Section>
</Base>

<style>
  .grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .more { margin-top: 1.2rem; }
  .connect { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); align-items: start; }
  .ig { margin-top: 2rem; }
</style>
