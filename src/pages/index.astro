---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sections from '../components/Sections.astro';

// The home page is the "home" entry of the Pages collection (src/content/pages/home.json), edited in /admin.
const page = await getEntry('pages', 'home');
---

<Base description={page?.data.description || undefined}>
  {page ? (
    <Sections sections={page.data.sections} />
  ) : (
    <section class="pad page-offset"><div class="wrap"><p class="muted">The home page has no content yet. Add a page called “home” in /admin.</p></div></section>
  )}
</Base>
