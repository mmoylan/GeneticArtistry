---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Spec from '../components/gallery/Spec.astro';
import Hero from '../components/Hero.astro';
import Specimen from '../components/Specimen.astro';
import Process from '../components/Process.astro';
import Catalogue from '../components/Catalogue.astro';
import Stats from '../components/Stats.astro';
import Connect from '../components/Connect.astro';
import PostCard from '../components/PostCard.astro';
import Journal from '../components/Journal.astro';
import TextBlock from '../components/TextBlock.astro';
import Statement from '../components/Statement.astro';
import ImageBand from '../components/ImageBand.astro';
import CtaBand from '../components/CtaBand.astro';
import SocialLinks from '../components/SocialLinks.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Logo from '../components/Logo.astro';
import LeafArt from '../components/LeafArt.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).slice(0, 1);
// Live demos use the real blocks from the home page so they always match what the editor sees.
const home = await getEntry('pages', 'home');
const block = (t: string): Record<string, any> => home?.data.sections.find((x: any) => x.type === t) ?? {};
const sampleImage = "data:image/svg+xml," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2f6b40"/><stop offset="1" stop-color="#d9c98a"/></linearGradient></defs><rect width="1200" height="600" fill="url(#g)"/></svg>');

const toc = [
  ['Page builder', [['builder', 'How blocks work']]],
  ['Page sections', [['hero', 'Hero'], ['specimen', 'About bento'], ['process', 'Process steps'], ['collection', 'Catalogue'], ['stats', 'Stats'], ['connect', 'Connect'], ['journal', 'Journal'], ['text', 'Text'], ['statement', 'Statement'], ['image', 'Image'], ['cta', 'Call to action'], ['postcard', 'Post card']]],
  ['Motion elements', [['section', 'ga-section'], ['backdrop', 'Page backdrop'], ['reveal', 'ga-reveal'], ['split', 'ga-split'], ['scrub', 'ga-scrub'], ['draw', 'ga-draw'], ['parallax', 'ga-parallax'], ['counter', 'ga-counter'], ['progress', 'ga-progress'], ['hscroll', 'ga-hscroll']]],
  ['Building blocks', [['logo', 'Logo'], ['leaf', 'LeafArt'], ['buttons', 'Buttons'], ['cards', 'Cards'], ['type', 'Typography'], ['social', 'Social links'], ['instagram', 'Instagram feed'], ['tokens', 'Colour tokens']]],
] as const;

const code = {
    hero: `{ "type": "hero", "title": "Genetics, <em>painted</em> by hand.", "leaf": "draw", "leaf_strength": "subtle" }\n\n// Add it from Pages → Sections → Add. Every field is optional; blanks fall back to sensible defaults.`,
  specimen: `{ "type": "about", "heading": "…", "body": "markdown", "facts": [{ "label": "Leaflets", "value": "5 to 9" }], "quote": "…" }`,
  process: `{ "type": "process", "heading": "From sketch to seed", "steps": [{ "title": "Select", "text": "…" }], "rail": true }`,
  collection: `{ "type": "collection", "heading": "The collection", "limit": 0, "cta_card": true }\n\n// Cards come from Site Settings → Genetics Lines (name, type, lineage, notes, status, colours).`,
  stats: `{ "type": "stats", "items": [{ "value": 12, "suffix": "+", "label": "Lines released" }], "count_up": true }`,
  connect: `{ "type": "connect", "heading": "Let's make something <em>rare.</em>", "show_email": true, "show_social": true, "show_instagram": true }\n\n// Email, phone and location come from Site Settings → Contact.`,
  builder: `{\n  "title": "Home",\n  "sections": [\n    { "type": "hero", "title": "…", "animation": { "entrance": "fade", "duration": 1200 } },\n    { "type": "about", "heading": "…", "spacing": "roomy" },\n    { "type": "cta", "heading": "…", "anchor": "contact" }\n  ]\n}\n\n// Stored in src/content/pages/<slug>.json and edited in /admin → Pages. The page called "home" is the home page; any other page appears at /<slug>.`,
  journal: `{ "type": "journal", "heading": "Notes from the grow room", "count": 3, "button_label": "All entries" }\n\n// Shows the newest published blog posts; hides itself when there are none.`,
  text: `{ "type": "text", "eyebrow": "Our story", "heading": "…", "body": "markdown paragraphs", "align": "left" }`,
  statement: `{ "type": "statement", "text": "One big sentence whose words light up as you scroll." }`,
  image: `{ "type": "image", "image": "/uploads/grow-room.jpg", "alt": "…", "caption": "…", "height": "tall", "parallax": true }`,
  cta: `{ "type": "cta", "heading": "Ready to talk?", "text": "…", "button_label": "Get in touch", "button_link": "#connect" }`,
  section: `<ga-section effect="rise" delay="0" duration="1000" data-headline="on" data-items="on" data-spacing="normal">\n  …a whole block…\n</ga-section>\n\n// Added automatically around every block by <Sections />. In /admin it is each block's Animation group:\n//   Block entrance: none | fade | rise | left | right | zoom      Speed / delay: milliseconds\n//   Headline words rise one by one: on | off                       Cards and paragraphs appear in turn: on | off\n//   Block-specific: hero leaf (draws / still / none, subtle→bold), process line, counting numbers, parallax image.`,
  postcard: `---\nimport PostCard from '../components/PostCard.astro';\nconst posts = await getCollection('blog');\n---\n<ul class="grid">\n  {posts.map((p) => <PostCard post={p} />)}\n</ul>`,
  reveal: `<ga-reveal>…anything…</ga-reveal>\n<ga-reveal delay="200">staggered by 200 ms</ga-reveal>\n<ga-reveal effect="fade">fades without sliding</ga-reveal>`,
  split: `<h2><ga-split>One breeder. <em>Every plant</em> a canvas.</ga-split></h2>\n\n<!-- Words rise into view. Inline tags such as <em> are kept. -->`,
  scrub: `<p class="display"><ga-scrub>Words light up one by one as you scroll past this paragraph.</ga-scrub></p>`,
  draw: `<!-- Scroll-driven: the lines draw as the block enters the screen -->\n<ga-draw><LeafArt stroke={1.2} /></ga-draw>\n\n<!-- Plays once when visible -->\n<ga-draw autoplay><LeafArt stroke={1.2} /></ga-draw>\n\n<!-- Any inline <svg> with <path>/<line>/<circle> works; --d (1→0) is exposed for custom effects. -->`,
  parallax: `<div style="position:relative; overflow:hidden; height:20rem">\n  <ga-parallax speed="0.25" rotate="0.05">…</ga-parallax>\n</div>\n\n<!-- Moves relative to its parent while scrolling. speed: -0.5…0.5, rotate: degrees per px. -->`,
  counter: `<ga-counter to="120" suffix="+">120+</ga-counter>`,
  progress: `<ga-progress aria-hidden="true"></ga-progress>\n\n<!-- Already in Base.astro; the green bar at the very top of every page. -->`,
  hscroll: `<ga-hscroll>\n  <div class="pin"> <!-- position: sticky; top: 0; height: 100svh; overflow: hidden -->\n    <div class="track"> <!-- display: flex; gap: 1.5rem; width: max-content -->\n      <article>…</article> <article>…</article>\n    </div>\n  </div>\n</ga-hscroll>\n\n<!-- Turns vertical scroll into a sideways slide at ≥860 px; keyboard focus scrolls cards into view. -->`,
  logo: `<Logo variant="mark" height={48} />\n<Logo variant="text-below" height={140} />\n<Logo variant="text-above" height={140} />\n\n<!-- Colours follow the active theme. Print versions: /public/logo/*.svg -->`,
  leaf: `<LeafArt class="my-leaf" stroke={1.2} />\n\n<!-- Outline leaf in currentColor: set colour and opacity from CSS; crop it by placing it half outside an overflow:hidden parent. -->`,
  buttons: `<a class="btn" href="#">Outline</a>\n<a class="btn solid" href="#">Solid</a>\n<button class="btn">Button</button>`,
  cards: `<div class="card">Soft card (cream)</div>\n<div class="card" style="background:var(--accent);color:var(--on-accent)">Accent card</div>`,
  type: `<p class="eyebrow">Eyebrow</p>\n<h1>…</h1> <h2>…</h2> <h3>…</h3>\n<p class="lede">Display-serif lead paragraph</p>\n<p class="muted">Secondary text</p>\n<p class="label">Small caps label</p>\n<h2 class="mega">Huge</h2>\n<em>Italic accent word</em>`,
  social: `<SocialLinks />\n\n<!-- Links come from Site Settings → Social Links: Name, Icon, URL. Pick "Icons only" or "Icons with text" with the Social link style option. -->\n<!-- Accessibility: the name is always in the page for screen readers (hidden visually in icons-only mode), icons are decorative, targets are 48 px, the focus ring is visible, and the new-tab hint is announced. -->`,
  backdrop: `<Base backdrop="subtle">…</Base>   <!-- subtle | medium | none -->\n\n<!-- Or set Background leaf on each page in /admin → Pages. Built from: -->\n<ga-parallax scope="page" speed="0.04" rotate="0.001">\n  <LeafArt />   <!-- 200vw wide, fixed behind the page, soft tan -->\n</ga-parallax>\n\n<!-- scope="page" drives the motion from total page scroll, so it works as a full-page background. -->`,
  instagram: `<InstagramFeed />\n\n<!-- With a Behold feed ID (site.json → instagram.behold_feed_id) it embeds the live grid; otherwise it shows a profile link. -->`,
  tokens: `color: var(--ink);  background: var(--bg-2);\nborder-color: var(--line);  color: var(--accent);\n\n<!-- Defined in src/styles/themes.css (one scheme; visitors who ask for more contrast get a stronger set). Every pairing is checked to WCAG AA. -->`,
};

const tokens = [
  ['--bg', 'Page'], ['--bg-2', 'Cards'], ['--ink', 'Text'], ['--muted', 'Secondary text'],
  ['--accent', 'Accent'], ['--on-accent', 'On accent'], ['--leaf', 'Leaf green'], ['--line', 'Lines'],
];
---

<Base title="Component gallery" description="Every building block available for pages." noindex>
  <section class="pad intro">
    <div class="wrap">
      <ga-reveal><p class="eyebrow">Design system</p></ga-reveal>
      <h1><ga-split>Component gallery</ga-split></h1>
      <ga-reveal><p class="lede muted">Every block available for building a page: full sections, scroll-motion elements and small building blocks. Each is live, with its usage underneath. Use the Theme control to see them in every colour scheme.</p></ga-reveal>
      <nav aria-label="Gallery contents" class="toc">
        {toc.map(([group, items]) => (
          <div>
            <h2 class="label">{group}</h2>
            <ul>{items.map(([id, label]) => <li><a href={`#g-${id}`}>{label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
  </section>

  <div class="wrap">
    <h2 class="group">Page builder</h2>
    <p class="muted g-intro">Pages are an ordered list of blocks edited in /admin → Pages. Add, remove or drag blocks to rearrange them, and set each block's animation, spacing and anchor. Every block below is available from the Sections → Add menu.</p>
    <Spec id="builder" kind="Concept" name="How blocks work" desc="A page is a JSON file holding a list of blocks. Each block has a type, its own content fields and three shared settings: Space above and below (none, compact, normal, roomy), an optional Anchor name for links like /#contact, and an Animation group." code={code.builder} />

    <h2 class="group">Page sections</h2>
    <p class="muted g-intro">Full-width sections you can drop into any page. Their text comes from the editable content files, so they update from the CMS.</p>
  </div>
  <div class="full">
    <div class="wrap"><Spec id="hero" kind="Section" name="Hero" desc="Dark rounded panel with a huge headline, call-to-action buttons and a faint, cropped leaf that draws itself from its centre." code={code.hero} replay /></div>
    <Hero data={block('hero')} uid="gd-hero" anchor="" />
    <div class="wrap"><Spec id="specimen" kind="Section" name="About bento" desc="Intro text plus a bento grid: a leaf plate, botanical facts and a philosophy card." code={code.specimen} /></div>
    <Specimen data={block('about')} uid="gd-about" anchor="" />
    <div class="wrap"><Spec id="process" kind="Section" name="Process steps" desc="Numbered steps joined by a line that draws across as you scroll." code={code.process} /></div>
    <Process data={block('process')} uid="gd-process" anchor="" />
    <div class="wrap"><Spec id="collection" kind="Section" name="Catalogue" desc="A card for each genetic line, with a partial leaf, status and lineage, plus a closing call-to-action card." code={code.collection} /></div>
    <Catalogue data={block('collection')} uid="gd-lines" anchor="" />
    <div class="wrap"><Spec id="stats" kind="Section" name="Stats" desc="Large figures that count up when they scroll into view." code={code.stats} /></div>
    <Stats data={block('stats')} uid="gd-stats" anchor="" />
    <div class="wrap"><Spec id="connect" kind="Section" name="Connect" desc="Contact panel with email, social links and the Instagram feed." code={code.connect} /></div>
    <Connect data={block('connect')} uid="gd-connect" anchor="" />
    <div class="wrap"><Spec id="journal" kind="Section" name="Journal" desc="Latest blog posts as cards, with a button to the full journal." code={code.journal} /></div>
    <Journal data={block('journal')} uid="gd-journal" anchor="" />
    <div class="wrap"><Spec id="text" kind="Section" name="Text" desc="Heading and body copy in a comfortable reading column, left aligned or centred. For general pages like About or FAQ." code={code.text} /></div>
    <TextBlock data={{ eyebrow: 'Our story', heading: 'Slow, careful and documented', body: 'Every line starts as a single seed and is followed for many seasons.\n\nNotes, photographs and measurements are kept for each plant, so nothing is left to memory.', align: 'left' }} uid="gd-text" anchor="" />
    <div class="wrap"><Spec id="statement" kind="Section" name="Statement" desc="One large sentence whose words light up as the visitor scrolls past it." code={code.statement} /></div>
    <Statement data={{ eyebrow: 'Principle', text: 'Most genetics are made to be common. Ours are made to be remembered.' }} uid="gd-statement" anchor="" />
    <div class="wrap"><Spec id="image" kind="Section" name="Image" desc="A wide picture with optional caption. It drifts gently as you scroll (parallax), which can be switched off. Shown here with a placeholder picture." code={code.image} /></div>
    <ImageBand data={{ image: sampleImage, alt: '', caption: 'Placeholder picture', height: 'short', parallax: true }} uid="gd-image" anchor="" />
    <div class="wrap"><Spec id="cta" kind="Section" name="Call to action" desc="An accent-coloured banner with a heading, a line of text and one button." code={code.cta} /></div>
    <CtaBand data={{ heading: 'Ready to talk genetics?', text: 'Ask about upcoming seed runs or just say hello.', button_label: 'Get in touch', button_link: '#g-connect' }} uid="gd-cta" anchor="" />
  </div>

  <div class="wrap">
    {posts.length > 0 && (
      <Spec id="postcard" kind="Block" name="Post card" desc="Journal entry card with date, tags, title and summary. Used in the blog list and on the home page." code={code.postcard}>
        <ul class="plist">{posts.map((p) => <PostCard post={p} />)}</ul>
      </Spec>
    )}

    <h2 class="group">Motion elements</h2>
    <p class="muted g-intro">Custom HTML elements (no framework). They respect “reduce motion” and fall back to plain, fully visible content without JavaScript.</p>

    <Spec id="section" kind="Element" name="ga-section" desc="The block-level wrapper that applies a block's Animation settings: how the whole block arrives, how fast, after what delay, and whether headline words and inner cards animate. Reacts as soon as any part of the block appears, so very tall blocks still animate." code={code.section} replay>
      <div class="trio">
        <ga-section effect="rise"><div class="card">rise</div></ga-section>
        <ga-section effect="zoom" delay="200"><div class="card">zoom, 200 ms delay</div></ga-section>
        <ga-section effect="left" delay="400" duration="1600"><div class="card">left, slow</div></ga-section>
      </div>
    </Spec>

    <Spec id="reveal" kind="Element" name="ga-reveal" desc="Fades and slides its content up when it scrolls into view. Optional delay in milliseconds and a fade-only effect." code={code.reveal} replay>
      <div class="trio">
        <ga-reveal><div class="card">Default</div></ga-reveal>
        <ga-reveal delay="200"><div class="card">delay="200"</div></ga-reveal>
        <ga-reveal effect="fade" delay="400"><div class="card">effect="fade"</div></ga-reveal>
      </div>
    </Spec>

    <Spec id="split" kind="Element" name="ga-split" desc="Splits a headline into words that rise into place one after another." code={code.split} replay>
      <h2 class="demo-h"><ga-split>One breeder. <em>Every plant</em> a canvas.</ga-split></h2>
    </Spec>

    <Spec id="scrub" kind="Element" name="ga-scrub" desc="Words light up one by one as you scroll past, so the reader's progress colours the text." code={code.scrub} note="Scroll slowly past the paragraph to see it fill.">
      <p class="display scrub-text"><ga-scrub>Every cross is selected, grown and documented by hand, treating each plant like a work of art in progress. Nothing is rushed and nothing is left to chance.</ga-scrub></p>
    </Spec>

    <Spec id="draw" kind="Element" name="ga-draw" desc="Draws any line-art SVG stroke by stroke. Scroll-driven by default, or autoplay once when visible. The leaf draws outward from its centre." code={code.draw} replay>
      <div class="pair">
        <figure><ga-draw autoplay class="leafbox"><LeafArt stroke={1.3} /></ga-draw><figcaption class="label muted">autoplay</figcaption></figure>
        <figure><ga-draw class="leafbox"><LeafArt stroke={1.3} /></ga-draw><figcaption class="label muted">scroll-driven</figcaption></figure>
      </div>
    </Spec>

    <Spec id="backdrop" kind="Element" name="Page backdrop" desc="A huge outline leaf, 200% of the page width, with 40% of it off the left or right screen edge,, fixed behind the whole page and drifting and turning slowly as you scroll. Drawn in the soft tan token (--tan) and kept faint so it never competes with text. Set per page as Background leaf: subtle, medium or none. It is hidden for visitors who request high contrast and when printing." code={code.backdrop} note="You are looking at it now: a faint leaf behind this whole page. Scroll to watch it move." />

    <Spec id="parallax" kind="Element" name="ga-parallax" desc="Moves its content at a different speed from the page, giving depth. Can also rotate slightly." code={code.parallax} note="Scroll up and down: the leaf drifts and turns inside its frame.">
      <div class="px">
        <ga-parallax speed="0.25" rotate="0.04"><LeafArt class="pxleaf" stroke={1.2} /></ga-parallax>
      </div>
    </Spec>

    <Spec id="counter" kind="Element" name="ga-counter" desc="A number that counts up from zero the first time it is seen." code={code.counter}>
      <p class="display big"><ga-counter to="120" suffix="+">120+</ga-counter></p>
    </Spec>

    <Spec id="progress" kind="Element" name="ga-progress" desc="A thin bar fixed to the top of the window that fills as you scroll the page." code={code.progress}>
      <p class="muted">Already on every page: watch the green line along the very top edge as you scroll this one.</p>
    </Spec>

    <Spec id="hscroll" kind="Element" name="ga-hscroll" desc="Pins a section and turns vertical scrolling into a sideways slide through a row of cards. Used in design A's collection." code={code.hscroll} note="Not used on this design's home page; it needs the sticky wrapper CSS shown in the usage.">
      <p class="muted">Code-only entry: a live demo would take over the page's scroll.</p>
    </Spec>

    <h2 class="group">Building blocks</h2>
    <p class="muted g-intro">Smaller pieces used inside the sections above. Mix them into any layout.</p>

    <Spec id="logo" kind="Block" name="Logo" desc="The GA mark with the paintbrush leg, in three layouts. Colours follow the active theme." code={code.logo}>
      <div class="logos">
        <Logo variant="mark" height={90} />
        <Logo variant="text-below" height={170} />
        <Logo variant="text-above" height={170} />
      </div>
    </Spec>

    <Spec id="leaf" kind="Block" name="LeafArt" desc="The outline cannabis leaf. Sits well as a faint, cropped background. Colour and opacity come from CSS." code={code.leaf}>
      <div class="leaves">
        <div class="lcard"><LeafArt class="l1" stroke={1.2} /></div>
        <div class="lcard"><LeafArt class="l2" stroke={1.2} /></div>
      </div>
    </Spec>

    <Spec id="buttons" kind="Block" name="Buttons" desc="Pill buttons in outline and solid styles, 48 px tall for easy tapping." code={code.buttons}>
      <p class="row"><a class="btn" href="#g-buttons">Outline</a><a class="btn solid" href="#g-buttons">Solid</a><button type="button" class="btn">Button</button></p>
    </Spec>

    <Spec id="cards" kind="Block" name="Cards" desc="Rounded surface for grouping content, in the soft cream tone or the accent colour." code={code.cards}>
      <div class="trio">
        <div class="card"><p class="label muted">Soft card</p><h3>Plain surface</h3><p class="muted">For facts, notes and lists.</p></div>
        <div class="card acc"><p class="label">Accent card</p><h3>Highlight</h3><p>For a key message.</p></div>
      </div>
    </Spec>

    <Spec id="type" kind="Block" name="Typography" desc="Bitter for headings, Montserrat for body and labels. Sizes scale fluidly with the screen." code={code.type}>
      <p class="eyebrow">Eyebrow</p>
      <h2>Heading two with <em>italic accent</em></h2>
      <h3>Heading three</h3>
      <p class="lede">Display-serif lead paragraph for introductions.</p>
      <p>Body text in Montserrat, comfortable line length and spacing.</p>
      <p class="muted">Secondary text.</p>
      <p class="label">Small caps label</p>
    </Spec>

    <Spec id="social" kind="Block" name="Social links" desc="Round, single-colour icon buttons (or text links) to your profiles, chosen per link in the CMS from a set of 25 icons. Each keeps a readable name for screen readers, a 48 px target and a visible focus ring." code={code.social}>
      <SocialLinks />
      <p class="label muted" style="margin:1.6rem 0 .8rem">The icon set</p>
      <ul class="iconset">
        {['instagram','facebook','x','youtube','tiktok','linkedin','pinterest','threads','bluesky','reddit','discord','mastodon','twitch','spotify','soundcloud','whatsapp','telegram','snapchat','vimeo','etsy','substack','patreon','github','email','website'].map((n) => (<li><SocialIcon name={n} size={22} /><span class="label muted">{n}</span></li>))}
      </ul>
    </Spec>

    <Spec id="instagram" kind="Block" name="Instagram feed" desc="Live Instagram grid through Behold, or a simple profile link until a feed is connected." code={code.instagram}>
      <InstagramFeed />
      <p class="muted">Nothing shows here until an Instagram handle or Behold feed ID is set in the CMS.</p>
    </Spec>

    <Spec id="tokens" kind="Reference" name="Colour tokens" desc="The colours every component is built from." code={code.tokens}>
      <ul class="tokens">
        {tokens.map(([v, label]) => (
          <li><span class="chip" style={`background:var(${v})`} aria-hidden="true"></span><code>{v}</code><span class="muted">{label}</span></li>
        ))}
      </ul>
    </Spec>
  </div>
</Base>

<script>
  // Replay buttons: restart the entrance animations inside one entry's demo stage.
  document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const spec = btn.closest('.spec');
      const els = spec ? [...spec.querySelectorAll<HTMLElement>('.stage ga-reveal, .stage ga-section, .stage ga-split, .stage ga-draw[autoplay]')] : [];
      // The hero and process entries demo the real section placed right after their label.
      const id = spec?.id;
      const extra = id === "g-hero" ? document.querySelectorAll<HTMLElement>('.hero ga-reveal, .hero ga-split, .hero ga-draw[autoplay]') : [];
      const all = [...els, ...extra];
      all.forEach((el) => el.classList.remove('in'));
      void document.body.offsetHeight;
      setTimeout(() => all.forEach((el) => el.classList.add('in')), 80);
    });
  });
</script>

<style>
  .intro { padding-top: clamp(7rem, 12vw, 9rem); }
  .intro h1 { margin: 1rem 0 1.2rem; }
  .intro .lede { max-width: 52ch; }
  .toc { display: grid; gap: 1.6rem 3rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 3rem; }
  .toc h2 { margin: 0 0 .6rem; color: var(--leaf); font-size: var(--t-label); font-family: var(--sans); letter-spacing: .24em; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .1rem .3rem; }
  .toc a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 .9rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 600; font-size: .9rem; }
  .toc a:hover { border-color: var(--accent); color: var(--accent); }
  .group { margin: clamp(3rem, 7vw, 5rem) 0 .6rem; }
  .g-intro { max-width: 62ch; margin-bottom: 1rem; }
  .full { margin-top: 1rem; }
  .trio { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .pair { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  figure { margin: 0; text-align: center; }
  figcaption { margin-top: .6rem; }
  .leafbox { width: min(100%, 260px); margin: 0 auto; color: var(--leaf); }
  .demo-h { margin: 0; }
  .scrub-text { font-size: var(--t-3); margin: 0; max-width: 40ch; }
