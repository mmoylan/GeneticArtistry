---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Journal" description="Grow notes, new lines and stories from Genetic Artistry.">
  <section class="pad top">
    <div class="wrap">
      <p class="eyebrow">Journal</p>
      <h1>Notes from the <em>grow room</em></h1>
      {posts.length === 0 ? <p class="muted">No entries yet.</p> : (
        <ul class="grid">{posts.map((p) => <PostCard post={p} />)}</ul>
      )}
    </div>
  </section>
</Base>

<style>
  .top { padding-top: clamp(8rem, 14vw, 11rem); }
  h1 { margin: 1.2rem 0 3rem; max-width: 14ch; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
</style>
