---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Journal" description="Grow notes, new lines and stories from Genetic Artistry.">
  <section class="pad top">
    <div class="wrap">
      <p class="eyebrow">Journal</p>
      <h1>Notes from the <em>grow room</em></h1>
      {posts.length === 0 ? <p class="muted">No entries yet.</p> : (
        <ol class="list">{posts.map((p, i) => <PostRow post={p} index={i} />)}</ol>
      )}
    </div>
  </section>
</Base>

<style>
  .top { padding-top: clamp(8rem, 16vw, 13rem); }
  h1 { margin: 1.5rem 0 4rem; font-size: var(--t-1); max-width: 12ch; }
  .list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
</style>
